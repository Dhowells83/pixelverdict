---
import CyberBackground from '../components/CyberBackground';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "PixelVerdict - High-precision gaming evaluations, technical benchmarks, and interactive hardware matrices.",
  image = "/og-default.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://pixelverdict.com');

const pixelLetters = "PIXEL".split('');
const verdictLetters = "VERDICT".split('');
---

<!doctype html>
<html lang="en" class="bg-[#070a12] text-slate-100 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <title>{title} | PixelVerdict</title>
    <meta name="title" content={`${title} | PixelVerdict`} />
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,500;0,700;0,800;1,400&family=Orbitron:wght@700;800;900&family=Press+Start+2P&display=swap" rel="stylesheet">

    <style is:global>
      @import "tailwindcss";

      :root {
        --font-heading: 'Orbitron', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --font-pixel: 'Press Start 2P', monospace;
      }

      body {
        font-family: 'Inter', sans-serif;
        background-color: #070a12;
        color: #f1f5f9;
        min-height: 100vh;
        overflow-x: hidden;
      }

      .font-heading { font-family: var(--font-heading) !important; }
      .font-mono-tech { font-family: var(--font-mono) !important; }
      .font-pixel-accent { font-family: var(--font-pixel) !important; }

      /* Visual Card Glassmorphism Fallback */
      .bg-\[\#131b2e\]\/80, .bg-\[\#131b2e\]\/70, .bg-\[\#131b2e\] {
        background-color: rgba(19, 27, 46, 0.85) !important;
      }
      
      .border-purple-900\/40, .border-purple-500\/30, .border-slate-800 {
        border-color: rgba(168, 85, 247, 0.35) !important;
      }

      /* Glow Effects */
      .text-glow-cyan {
        text-shadow: 0 0 12px rgba(6, 182, 212, 0.6);
      }

      /* Logo Letter Hop Animation Keyframes */
      @keyframes pixelHop {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
      }

      .logo-letter {
        display: inline-block;
        transition: transform 0.2s ease;
      }

      .logo-container:hover .logo-letter {
        animation: pixelHop 0.35s ease-in-out;
        animation-delay: var(--delay);
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-track { background: #070a12; }
      ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
        border: 1px solid rgba(168, 85, 247, 0.3);
      }
      ::-webkit-scrollbar-thumb:hover { background: #a855f7; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-purple-600 selection:text-white bg-[#070a12] text-slate-100 relative">
    
    <!-- Animated HTML5 Canvas Background Particle Layer -->
    <CyberBackground client:only="react" />

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-[#0d1322]/95 border-b border-purple-500/30 backdrop-blur-md shadow-[0_4px_25px_rgba(0,0,0,0.6)]">
      <div class="max-w-6xl mx-auto px-4 py-3.5 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="logo-container group flex items-center gap-3">
          <div class="w-9 h-9 bg-gradient-to-tr from-purple-600 via-purple-500 to-cyan-400 rounded-xl flex items-center justify-center font-bold text-white shadow-[0_0_18px_rgba(168,85,247,0.5)] border border-purple-300/40 group-hover:scale-110 transition-transform">
            <span class="font-pixel-accent text-[9px]">P</span>
          </div>

          <span class="font-heading font-black text-xl tracking-tight text-white flex items-center select-none">
            {pixelLetters.map((char, i) => (
              <span 
                key={`p-${i}`} 
                class="logo-letter group-hover:text-purple-300" 
                style={`--delay: ${i * 0.04}s`}
              >
                {char}
              </span>
            ))}
            {verdictLetters.map((char, i) => (
              <span 
                key={`v-${i}`} 
                class="logo-letter text-cyan-400 text-glow-cyan" 
                style={`--delay: ${(pixelLetters.length + i) * 0.04}s`}
              >
                {char}
              </span>
            ))}
          </span>
        </a>

        <!-- Links -->
        <nav class="flex items-center gap-6 font-mono-tech text-xs font-bold">
          <a href="/#reviews" class="text-slate-300 hover:text-cyan-400 transition-colors tracking-wider uppercase">// ALL REVIEWS</a>
          <a href="/#reviews" class="px-4 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white transition-all shadow-[0_0_15px_rgba(168,85,247,0.4)] border border-purple-400/40">
            SEARCH
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Body Container -->
    <main class="max-w-6xl mx-auto px-4 py-8 w-full flex-grow relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-purple-900/30 bg-[#05070e] py-8 text-center text-xs font-mono-tech text-slate-500 relative z-10">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-500 shadow-[0_0_8px_#a855f7] animate-pulse"></span>
          <span class="font-heading font-bold text-slate-300 tracking-wider">PIXELVERDICT</span>
        </div>
        <p>© {new Date().getFullYear()} PixelVerdict. All rights reserved.</p>
        <div class="flex items-center gap-4 text-slate-400">
          <a href="#" class="hover:text-cyan-400 transition-colors">Privacy</a>
          <a href="#" class="hover:text-cyan-400 transition-colors">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>