---
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "PixelVerdict - High-precision gaming evaluations, technical benchmarks, and interactive hardware matrices.",
  image = "/og-default.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://pixelverdict.com');

const pixelLetters = "PIXEL".split('');
const verdictLetters = "VERDICT".split('');

// Micro-particle swarm setup
const particles = Array.from({ length: 28 }, (_, i) => ({
  id: i,
  top: `${Math.floor(Math.random() * 90) + 5}%`,
  left: `${Math.floor(Math.random() * 90) + 5}%`,
  size: `${(i % 3) * 2 + 3}px`,
  colorClass: i % 2 === 0 ? 'particle-purple' : 'particle-cyan',
  animDuration: `${Math.floor(Math.random() * 10) + 12}s`,
  animDelay: `-${Math.floor(Math.random() * 8)}s`
}));
---

<!doctype html>
<html lang="en" data-theme="sleek" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <title>{title} | PixelVerdict</title>
    <meta name="title" content={`${title} | PixelVerdict`} />
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,500;0,700;0,800;1,400&family=Orbitron:wght@700;800;900&family=Press+Start+2P&display=swap" rel="stylesheet">

    <style is:global>
      @import "tailwindcss";

      /* Cyber-Sleek Default Palette */
      :root, html[data-theme="sleek"] {
        --bg-main: #05070e;
        --card-bg: rgba(19, 27, 46, 0.85);
        --header-bg: rgba(13, 19, 34, 0.95);
        --border-color: rgba(168, 85, 247, 0.35);
        --accent-purple: #a855f7;
        --accent-cyan: #06b6d4;
        --grid-line-a: rgba(168, 85, 247, 0.12);
        --grid-line-b: rgba(6, 182, 212, 0.12);
        --font-heading: 'Orbitron', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --font-pixel: 'Press Start 2P', monospace;
      }

      /* OLED High-Contrast Palette */
      html[data-theme="contrast"] {
        --bg-main: #000000;
        --card-bg: #050805;
        --header-bg: #000000;
        --border-color: #00ff66;
        --accent-purple: #00ff66;
        --accent-cyan: #00ff66;
        --grid-line-a: rgba(0, 255, 102, 0.15);
        --grid-line-b: rgba(0, 255, 102, 0.15);
      }

      html, body {
        background-color: var(--bg-main) !important;
        color: #f1f5f9;
        min-height: 100vh;
        overflow-x: hidden;
        margin: 0;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .font-heading { font-family: var(--font-heading) !important; }
      .font-mono-tech { font-family: var(--font-mono) !important; }
      .font-pixel-accent { font-family: var(--font-pixel) !important; }

      /* Visual Card Glassmorphism Adaptations */
      .bg-\[\#131b2e\]\/80, .bg-\[\#131b2e\]\/70, .bg-\[\#131b2e\] {
        background-color: var(--card-bg) !important;
        backdrop-filter: blur(12px);
      }
      
      .border-purple-900\/40, .border-purple-500\/30, .border-slate-800 {
        border-color: var(--border-color) !important;
      }

      /* Cyber Mesh Grid */
      .bg-cyber-grid {
        background-image: 
          linear-gradient(to right, var(--grid-line-a) 1px, transparent 1px),
          linear-gradient(to bottom, var(--grid-line-b) 1px, transparent 1px);
        background-size: 50px 50px;
      }

      /* Particle Animations */
      @keyframes floatParticleA {
        0%, 100% { transform: translate(0px, 0px); opacity: 0.3; }
        50% { transform: translate(60px, -70px); opacity: 0.9; }
      }

      @keyframes floatParticleB {
        0%, 100% { transform: translate(0px, 0px); opacity: 0.8; }
        50% { transform: translate(-70px, 80px); opacity: 0.35; }
      }

      .particle-node {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
      }

      .particle-purple {
        background-color: var(--accent-purple);
        box-shadow: 0 0 10px var(--accent-purple);
        animation: floatParticleA ease-in-out infinite;
      }

      .particle-cyan {
        background-color: var(--accent-cyan);
        box-shadow: 0 0 10px var(--accent-cyan);
        animation: floatParticleB ease-in-out infinite;
      }

      .text-glow-cyan {
        text-shadow: 0 0 12px var(--accent-cyan);
      }

      @keyframes pixelHop {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
      }

      .logo-letter {
        display: inline-block;
        transition: transform 0.2s ease;
      }

      .logo-container:hover .logo-letter {
        animation: pixelHop 0.35s ease-in-out;
        animation-delay: var(--delay);
      }

      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-track { background: var(--bg-main); }
      ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
        border: 1px solid var(--border-color);
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--accent-purple); }
    </style>
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-purple-600 selection:text-white relative">
    
    <!-- Background Particles & Mesh -->
    <div class="fixed inset-0 pointer-events-none" style="z-index: 0;">
      <div class="absolute inset-0 bg-cyber-grid"></div>

      {particles.map((p) => (
        <div 
          key={p.id}
          class={`particle-node ${p.colorClass}`}
          style={`top: ${p.top}; left: ${p.left}; width: ${p.size}; height: ${p.size}; animation-duration: ${p.animDuration}; animation-delay: ${p.animDelay};`}
        />
      ))}
    </div>

    <!-- Navigation Header with Theme Toggle -->
    <header class="sticky top-0 z-50 bg-[var(--header-bg)] border-b border-[var(--border-color)] backdrop-blur-md shadow-[0_4px_25px_rgba(0,0,0,0.6)]">
      <div class="max-w-6xl mx-auto px-4 py-3.5 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="logo-container group flex items-center gap-3">
          <div class="w-9 h-9 bg-gradient-to-tr from-purple-600 via-purple-500 to-cyan-400 rounded-xl flex items-center justify-center font-bold text-white shadow-[0_0_18px_rgba(168,85,247,0.5)] border border-purple-300/40 group-hover:scale-110 transition-transform">
            <span class="font-pixel-accent text-[9px]">P</span>
          </div>

          <span class="font-heading font-black text-xl tracking-tight text-white flex items-center select-none">
            {pixelLetters.map((char, i) => (
              <span 
                key={`p-${i}`} 
                class="logo-letter group-hover:text-purple-300" 
                style={`--delay: ${i * 0.04}s`}
              >
                {char}
              </span>
            ))}
            {verdictLetters.map((char, i) => (
              <span 
                key={`v-${i}`} 
                class="logo-letter text-cyan-400 text-glow-cyan" 
                style={`--delay: ${(pixelLetters.length + i) * 0.04}s`}
              >
                {char}
              </span>
            ))}
          </span>
        </a>

        <!-- Header Nav Links & Theme Switcher -->
        <nav class="flex items-center gap-4 md:gap-6 font-mono-tech text-xs font-bold">
          <a href="/#reviews" class="text-slate-300 hover:text-[var(--accent-cyan)] transition-colors tracking-wider uppercase">// ALL REVIEWS</a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <!-- Main Body Container -->
    <main class="max-w-6xl mx-auto px-4 py-8 w-full flex-grow relative" style="z-index: 10;">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--border-color)] bg-[var(--bg-main)] py-8 text-center text-xs font-mono-tech text-slate-500 relative" style="z-index: 10;">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-purple)] shadow-[0_0_8px_var(--accent-purple)] animate-pulse"></span>
          <span class="font-heading font-bold text-slate-300 tracking-wider">PIXELVERDICT</span>
        </div>
        <p>© {new Date().getFullYear()} PixelVerdict. All rights reserved.</p>
        <div class="flex items-center gap-4 text-slate-400">
          <a href="#" class="hover:text-[var(--accent-cyan)] transition-colors">Privacy</a>
          <a href="#" class="hover:text-[var(--accent-cyan)] transition-colors">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>