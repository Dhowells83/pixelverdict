---
import Layout from '../layouts/Layout.astro';
import ReleaseScheduleGrid from '../components/ReleaseScheduleGrid';
---

<Layout title="Upcoming Video Game Release Schedule 2026">
  <section class="py-8 text-center">
    <span class="inline-block px-3.5 py-1 bg-purple-950/80 border border-purple-500/40 rounded-full text-xs font-mono-tech font-bold text-purple-300 mb-4 shadow-[0_0_15px_rgba(168,85,247,0.3)]">
      // LIVE DATABASE FEED
    </span>

    <h1 class="text-4xl md:text-5xl font-heading font-black tracking-tight text-white uppercase mb-4">
      RELEASE <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-cyan-400">SCHEDULE</span>
    </h1>

    <p class="text-slate-300 font-mono-tech text-sm max-w-xl mx-auto mb-10">
      Upcoming PC, PlayStation 5, Xbox Series X/S, and Nintendo Switch title calendar.
    </p>

    <ReleaseScheduleGrid client:load />
  </section>
</Layout>